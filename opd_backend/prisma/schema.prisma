generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model appointment {
  AppointmentID       Int                 @id @default(autoincrement())
  AppointmentDateTime DateTime?           @db.DateTime(0)
  PatientID           Int?
  DoctorID            Int?
  Status              appointment_Status?

  patient patient? @relation(fields: [PatientID], references: [PatientID])
  doctor  doctor?  @relation(fields: [DoctorID], references: [DoctorID])

  @@index([DoctorID], map: "DoctorID")
  @@index([PatientID], map: "PatientID")
}

model department {
  DepartmentID   Int    @id @default(autoincrement())
  DepartmentName String @db.VarChar(255)
  HospitalID     Int?

  hospital hospital? @relation(fields: [HospitalID], references: [HospitalID])
  doctors  doctor[]

  @@index([HospitalID], map: "HospitalID")
}

model diagnosis {
  DiagnosisID   Int     @id @default(autoincrement())
  DiagnosisName String? @db.VarChar(255)
  ICDCode       String? @db.VarChar(50)

  opddiagnoses opddiagnosis[]
}

model doctor {
  DoctorID        Int      @id @default(autoincrement())
  DoctorName      String   @db.VarChar(255)
  DepartmentID    Int
  ConsultationFee Decimal? @db.Decimal(10, 2)
  HospitalID      Int?
  UserID          Int?     @unique(map: "UserID")
  photourl        String?  @db.VarChar(100)
  Mobile          String?  @unique(map: "Mobile_UNIQUE") @db.VarChar(20)

  department department @relation(fields: [DepartmentID], references: [DepartmentID])
  hospital   hospital?  @relation(fields: [HospitalID], references: [HospitalID])
  user       user?      @relation(fields: [UserID], references: [UserID])

  appointments          appointment[]
  doctorspecializations doctorspecialization[]
  opdvisits             opdvisit[]

  @@index([DepartmentID], map: "DepartmentID")
  @@index([HospitalID], map: "HospitalID")
}

model doctorspecialization {
  DoctorSpecializationID Int       @id @default(autoincrement())
  DoctorID               Int
  SpecializationID       Int
  YearsOfExperience      Int?
  IsPrimary              Boolean?  @default(false)
  CreatedAt              DateTime? @default(now()) @db.DateTime(0)

  doctor         doctor         @relation(fields: [DoctorID], references: [DoctorID])
  specialization specialization @relation(fields: [SpecializationID], references: [SpecializationID])

  @@unique([DoctorID, SpecializationID], map: "DoctorID")
  @@index([SpecializationID], map: "SpecializationID")
}

model hospital {
  HospitalID         Int       @id @default(autoincrement())
  HospitalName       String    @db.VarChar(255)
  RegistrationCharge Decimal?  @db.Decimal(10, 2)
  OpeningDate        DateTime? @db.Date
  Address            String?   @db.VarChar(255)
  ContactInfo        String?   @db.VarChar(100)

  departments department[]
  doctors     doctor[]
}

model invoice {
  InvoiceID     Int       @id @default(autoincrement())
  InvoiceNo     String?   @unique(map: "InvoiceNo") @db.VarChar(50)
  OPDID         Int?
  InvoiceDate   DateTime? @db.DateTime(0)
  TotalAmount   Decimal?  @db.Decimal(10, 2)
  PaymentModeID Int?

  opdvisit    opdvisit?    @relation(fields: [OPDID], references: [OPDID])
  paymentmode paymentmode? @relation(fields: [PaymentModeID], references: [PaymentModeID])

  invoiceitems invoiceitem[]

  @@index([OPDID], map: "OPDID")
  @@index([PaymentModeID], map: "PaymentModeID")
}

model invoiceitem {
  InvoiceItemID Int      @id @default(autoincrement())
  InvoiceID     Int?
  ServiceID     Int?
  Quantity      Int?
  Rate          Decimal? @db.Decimal(10, 2)
  Amount        Decimal? @db.Decimal(10, 2)

  invoice invoice? @relation(fields: [InvoiceID], references: [InvoiceID])
  service service? @relation(fields: [ServiceID], references: [ServiceID])

  @@index([InvoiceID], map: "InvoiceID")
  @@index([ServiceID], map: "ServiceID")
}

model opddiagnosis {
  OPDDiagnosisID Int  @id @default(autoincrement())
  OPDID          Int?
  DiagnosisID    Int?

  opdvisit  opdvisit?  @relation(fields: [OPDID], references: [OPDID])
  diagnosis diagnosis? @relation(fields: [DiagnosisID], references: [DiagnosisID])

  @@index([DiagnosisID], map: "DiagnosisID")
  @@index([OPDID], map: "OPDID")
}

model opdvisit {
  OPDID           Int                 @id @default(autoincrement())
  OPDNo           String?             @unique(map: "OPDNo") @db.VarChar(50)
  PatientID       Int?
  DoctorID        Int?
  VisitDateTime   DateTime?           @db.DateTime(0)
  VisitType       opdvisit_VisitType?
  RegistrationFee Decimal?            @db.Decimal(10, 2)

  patient patient? @relation(fields: [PatientID], references: [PatientID])
  doctor  doctor?  @relation(fields: [DoctorID], references: [DoctorID])

  invoices     invoice[]
  opddiagnoses opddiagnosis[]

  @@index([DoctorID], map: "DoctorID")
  @@index([PatientID], map: "PatientID")
}

model patient {
  PatientID Int            @id @default(autoincrement())
  PatientNo Int            @unique(map: "PatientNo")
  FullName  String         @db.VarChar(255)
  DOB       DateTime       @db.Date
  Gender    patient_Gender
  Mobile    String         @unique(map: "Mobile_Patient_UNIQUE") @db.VarChar(20)
  Address   String         @db.VarChar(255)
  UserID    Int?           @unique(map: "UserID")

  user user? @relation(fields: [UserID], references: [UserID])

  appointments appointment[]
  opdvisits    opdvisit[]
}

model paymentmode {
  PaymentModeID   Int     @id @default(autoincrement())
  PaymentModeName String? @db.VarChar(100)

  invoices invoice[]
}

model role {
  RoleID   Int    @id @default(autoincrement())
  RoleName String @unique(map: "RoleName") @db.VarChar(50)

  users user[]
}

model service {
  ServiceID       Int      @id @default(autoincrement())
  TreatmentTypeID Int?
  ServiceName     String?  @db.VarChar(255)
  Rate            Decimal? @db.Decimal(10, 2)

  treatmenttype treatmenttype? @relation(fields: [TreatmentTypeID], references: [TreatmentTypeID])

  invoiceitems invoiceitem[]

  @@index([TreatmentTypeID], map: "TreatmentTypeID")
}

model specialization {
  SpecializationID   Int     @id @default(autoincrement())
  SpecializationName String  @unique(map: "SpecializationName") @db.VarChar(255)
  Description        String? @db.VarChar(255)

  doctorspecializations doctorspecialization[]
}

model treatmenttype {
  TreatmentTypeID   Int     @id @default(autoincrement())
  TreatmentTypeName String? @db.VarChar(255)

  services service[]
}

model user {
  UserID    Int       @id @default(autoincrement())
  Username  String    @unique(map: "Username") @db.VarChar(100)
  Password  String    @db.VarChar(255)
  RoleID    Int
  CreatedAt DateTime? @default(now()) @db.DateTime(0)
  UpdatedAt DateTime? @default(now()) @db.DateTime(0)
  Mobile    String?   @unique(map: "Mobile") @db.VarChar(20)

  role role @relation(fields: [RoleID], references: [RoleID])

  doctor  doctor?
  patient patient?

  @@index([RoleID], map: "RoleID")
}

enum appointment_Status {
  Completed
  Scheduled
}

enum patient_Gender {
  Male
  Female
  Other
}

enum opdvisit_VisitType {
  New
  FollowUp
}
